#
# DesktopRobot backend – copy to .env and fill in values.
#
# Required:
# - OPENAI_API_KEY: used for OpenAI Realtime / Responses APIs
#
# Optional (web search in the agent):
# - BRAVE_SEARCH_API_KEY
#
# Optional (custom ElevenLabs voice for TTS when implemented):
# - ELEVEN_LABS_API_KEY: your ElevenLabs API key
# - ELEVEN_LABS_VOICE_ID: voice_id returned when you create a voice at ElevenLabs (e.g. POST /v1/voices/add)
#
# Optional (Spotify search + playback – AI can play/queue songs):
# - SPOTIFY_CLIENT_ID: from Spotify Developer Dashboard
# - SPOTIFY_CLIENT_SECRET: from Spotify Developer Dashboard
# See SPOTIFY_INTEGRATION.md for setup.

OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=

ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
